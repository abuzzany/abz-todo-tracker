<%= form_with(model: category, class: "space-y-5") do |form| %>
  <% if category.errors.any? %>
    <div class="rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800">
      <h2 class="mb-1 font-medium"><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h2>
      <ul class="list-disc pl-5">
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-1.5 block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, placeholder: "e.g. Personal", class: "w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 transition focus:border-gray-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
  </div>

  <div class="pt-2">
    <%= form.submit class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500/40" %>
  </div>
<% end %>
