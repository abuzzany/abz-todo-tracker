<% content_for :title, "New category" %>

<div class="mx-auto w-full max-w-md">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-bold text-gray-900">New category</h1>
    <p class="mt-1 text-sm text-gray-500">Add a category to organize your to-dos.</p>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <%= render "form", category: @category %>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "← Back to categories", categories_path, class: "text-sm font-medium text-gray-500 hover:text-blue-600" %>
  </div>
</div>
