<% content_for :title, "Account" %>

<div class="mx-auto w-full max-w-md">
  <div class="mb-6 text-center">
    <h1 class="text-2xl font-bold text-gray-900">Account</h1>
    <p class="mt-1 text-sm text-gray-500">Update your email or password.</p>
  </div>

  <%= render "devise/shared/flash" %>

  <div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm sm:p-8">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "mb-1.5 block text-sm font-medium text-gray-700" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 transition focus:border-gray-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
      </div>

      <div>
        <%= f.label :password, "New password", class: "mb-1.5 block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 transition focus:border-gray-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
        <p class="mt-1 text-xs text-gray-500">
          Leave blank to keep your current password.
          <% if @minimum_password_length %><%= @minimum_password_length %> characters minimum.<% end %>
        </p>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm new password", class: "mb-1.5 block text-sm font-medium text-gray-700" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 transition focus:border-gray-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
      </div>

      <div>
        <%= f.label :current_password, class: "mb-1.5 block text-sm font-medium text-gray-700" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full rounded-lg border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 transition focus:border-gray-300 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20" %>
        <p class="mt-1 text-xs text-gray-500">Needed to confirm your changes.</p>
      </div>

      <div class="pt-2">
        <%= f.submit "Update", class: "w-full cursor-pointer rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500/40" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 rounded-2xl border border-red-100 bg-white p-6 shadow-sm sm:p-8">
    <h2 class="text-sm font-semibold text-gray-900">Delete account</h2>
    <p class="mt-1 text-sm text-gray-500">This permanently deletes your account.</p>
    <%= button_to "Delete my account", registration_path(resource_name), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "mt-4 cursor-pointer rounded-full bg-red-50 px-3 py-1 text-sm font-medium text-red-600 hover:bg-red-100" %>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "← Back to to-dos", root_path, class: "text-sm font-medium text-gray-500 hover:text-blue-600" %>
  </div>
</div>
