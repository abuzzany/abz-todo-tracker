<div class="mt-6 space-y-2 text-center text-sm">
  <%- if controller_name != 'sessions' %>
    <p class="text-gray-500">Already have an account? <%= link_to "Log in", new_session_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-700" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p class="text-gray-500">Don't have an account? <%= link_to "Sign up", new_registration_path(resource_name), class: "font-medium text-blue-600 hover:text-blue-700" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "font-medium text-gray-500 hover:text-blue-600" %></p>
  <% end %>
</div>
