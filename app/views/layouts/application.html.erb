<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Abz Todo Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Abz Todo Tracker">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="fixed inset-x-0 top-0 z-10 border-b border-gray-200 bg-white/80 backdrop-blur">
      <div class="container mx-auto flex items-center gap-6 px-5 py-4 text-sm font-medium text-gray-500">
        <% if user_signed_in? %>
          <%= link_to "To do items", to_do_items_path, class: "hover:text-blue-600" %>
          <%= link_to "Categories", categories_path, class: "hover:text-blue-600" %>
          <div class="ml-auto flex items-center gap-4">
            <%= link_to current_user.email, edit_user_registration_path, class: "hidden hover:text-blue-600 sm:inline" %>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "cursor-pointer hover:text-blue-600" %>
          </div>
        <% end %>
      </div>
    </nav>
    <main class="container mx-auto flex flex-col px-5 py-28">
      <%= yield %>
    </main>
  </body>
</html>
