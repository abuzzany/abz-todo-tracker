<% weeks = heatmap_grid(@heatmap_counts_by_day) %>
<% pill_classes = "rounded-full px-3 py-1 text-xs font-medium transition" %>
<% active_pill = "#{pill_classes} bg-gray-900 text-white" %>
<% inactive_pill = "#{pill_classes} bg-gray-100 text-gray-600 hover:bg-gray-200" %>
<% pill_data = { turbo_frame: "completion_streak", turbo_action: "advance" } %>

<%= turbo_frame_tag "completion_streak", class: "mb-6 block rounded-2xl border border-gray-200 bg-white p-6 shadow-sm" do %>
  <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-sm font-medium text-gray-700">Completion streak</h2>
      <% if @streak_category %>
        <p id="category-streak" class="mt-1 text-xs text-gray-500">
          <%= @streak_category.name %>: current <%= pluralize(@heatmap_streak.current, "day") %> ·
          longest <%= pluralize(@heatmap_streak.longest, "day") %>
        </p>
      <% end %>
    </div>

    <nav id="streak-category-filter" aria-label="Filter streak by category" class="flex flex-wrap gap-2">
      <%= link_to "All", streak_category_path(nil), class: @streak_category ? inactive_pill : active_pill, aria: { current: @streak_category ? nil : "true" }, data: pill_data %>
      <% @streak_categories.each do |category| %>
        <% selected = category == @streak_category %>
        <%= link_to category.name, streak_category_path(category), class: selected ? active_pill : inactive_pill, aria: { current: selected ? "true" : nil }, data: pill_data %>
      <% end %>
    </nav>
  </div>

  <%# RTL on the scroll container makes narrow screens start scrolled to the most recent weeks. %>
  <div class="overflow-x-auto pb-1 [direction:rtl]">
    <div id="completion-heatmap"
         class="grid min-w-[40rem] grid-flow-col [direction:ltr] grid-rows-[auto_repeat(7,auto)] gap-1"
         style="grid-template-columns: auto repeat(<%= weeks.length %>, minmax(0, 1fr));">
      <span></span>
      <% heatmap_weekday_labels.each do |label| %>
        <span class="heatmap-weekday-label flex items-center pr-1 text-[10px] leading-none text-gray-400"><%= label %></span>
      <% end %>

      <% weeks.each do |week| %>
        <span class="h-4 overflow-visible whitespace-nowrap text-[10px] leading-4 text-gray-400"><%= heatmap_month_label(week) %></span>
        <% week.each do |cell| %>
          <span
            data-heatmap-date="<%= cell[:date] %>"
            data-heatmap-count="<%= cell[:count] %>"
            title="<%= heatmap_cell_title(cell, @heatmap_breakdown_by_day, category: @streak_category) %>"
            class="aspect-square w-full rounded-sm <%= heatmap_cell_class(cell[:level]) %>"
          ></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-end gap-1 text-[10px] text-gray-400">
    <span class="mr-1">Less</span>
    <% (0..4).each do |level| %>
      <span class="h-2.5 w-2.5 rounded-sm <%= heatmap_cell_class(level) %>"></span>
    <% end %>
    <span class="ml-1">More</span>
  </div>
<% end %>
