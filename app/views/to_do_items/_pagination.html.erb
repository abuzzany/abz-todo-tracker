<% if total_pages > 1 %>
  <% first_item = (page - 1) * per_page + 1 %>
  <% last_item = [ page * per_page, total_count ].min %>
  <% link_classes = "rounded-lg border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50" %>
  <% disabled_classes = "rounded-lg border border-gray-100 px-3 py-1.5 text-sm font-medium text-gray-300" %>

  <nav id="to_do_items_pagination" aria-label="Pagination" class="flex flex-wrap items-center justify-between gap-3 border-t border-gray-200 px-4 py-3">
    <p class="text-sm text-gray-500">
      Showing <span class="font-medium text-gray-700"><%= first_item %>–<%= last_item %></span>
      of <span class="font-medium text-gray-700"><%= total_count %></span>
    </p>

    <div class="flex items-center gap-2">
      <% if page > 1 %>
        <%= link_to "Previous", to_do_items_path(request.query_parameters.merge("page" => page - 1)), rel: "prev", class: link_classes, data: { turbo_frame: "to_do_items_table", turbo_action: "advance" } %>
      <% else %>
        <span class="<%= disabled_classes %>" aria-disabled="true">Previous</span>
      <% end %>

      <span class="text-sm text-gray-500">Page <span id="current-page"><%= page %></span> of <%= total_pages %></span>

      <% if page < total_pages %>
        <%= link_to "Next", to_do_items_path(request.query_parameters.merge("page" => page + 1)), rel: "next", class: link_classes, data: { turbo_frame: "to_do_items_table", turbo_action: "advance" } %>
      <% else %>
        <span class="<%= disabled_classes %>" aria-disabled="true">Next</span>
      <% end %>
    </div>
  </nav>
<% end %>
